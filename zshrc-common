# OPENSPEC:START
# OpenSpec shell completions configuration
fpath=("/Users/adam/.oh-my-zsh/custom/completions" $fpath)
autoload -Uz compinit
compinit
# OPENSPEC:END

DOTFILES_DIR=${HOME}/.dotfiles
ZSH=${HOME}/.oh-my-zsh
ZSH_THEME="clean"
COMPLETION_WAITING_DOTS="true"
DISABLE_UNTRACKED_FILES_DIRTY="true"
HIST_STAMPS="yyyy-mm-dd"

plugins=(git golang ssh kubectl aws gcloud podman ruby brew gem github yarn npm tmux postgres opentofu nodenv rbenv doctl bundler)

fpath+=$HOME/.zfunc

source $ZSH/oh-my-zsh.sh
source $HOME/.profile

if command -v sw_vers > /dev/null; then
  source $DOTFILES_DIR/zshrc-mac
else
  source $DOTFILES_DIR/zshrc-linux
fi

autoload -Uz compinit
compinit

if command -v /usr/sbin/wsl2-ssh-agent > /dev/null; then
  eval "$(/usr/sbin/wsl2-ssh-agent)"
fi


# The next line updates PATH for the Google Cloud SDK.
if [ -f '/usr/local/src/google-cloud-sdk/path.zsh.inc' ]; then . '/usr/local/src/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/usr/local/src/google-cloud-sdk/completion.zsh.inc' ]; then . '/usr/local/src/google-cloud-sdk/completion.zsh.inc'; fi
