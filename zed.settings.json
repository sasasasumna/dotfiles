// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "terminal": {
    "shell": "system",
  },
  "languages": {
    "SQL": {
      "language_servers": ["sqruff"],
      "formatter": { "language_server": { "name": "sqruff" } },
    },
    "Go": {
      "soft_wrap": "editor_width",
      "hard_tabs": true,
    },
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "document_folding_ranges": "on",
  // "semantic_tokens": "combined",
  "proxy": "",
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "gemini": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "context_servers": {
    "mcp-server-context7": {
      "enabled": false,
      "remote": false,
      "settings": {},
    },
    "chrome-devtools-mcp-zed": {
      "enabled": true,
      "settings": {
        "channel": "dev",
      },
    },
    "mcp-server-github": {
      "enabled": true,
      "settings": {
        "github_personal_access_token": "$GITHUB_TOKEN",
      },
    },
  },
  "agent": {
    "default_model": {
      "effort": "medium",
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
      "enable_thinking": true,
    },
    "dock": "right",
    "show_turn_stats": true,
    "play_sound_when_agent_done": "always",
  },
  "autosave": "on_focus_change",
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
  },
  "buffer_font_family": "Hasklug Nerd Font Mono",
  "buffer_font_size": 15,
  "file_types": {
    "Groovy": ["Jenkinsfile", "**/Jenkinsfile"],
  },
  "preferred_line_length": 120,
  "project_panel": {
    "button": true,
    "default_width": 240,
    "dock": "left",
    "entry_spacing": "comfortable",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 20,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "scrollbar": {
      "show": null,
    },
    "show_diagnostics": "all",
    "indent_guides": {
      "show": "always",
    },
    "hide_root": true,
  },
  "scrollbar": {
    "show": "auto",
  },
  "tab_size": 2,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "ui_font_features": {
    "calt": true,
  },
  "vim_mode": true,
  "wsl_connections": [
    {
      "distro_name": "archlinux",
      "user": null,
      "projects": [],
    },
  ],
  "ui_font_size": 16,
  "language_models": {
    "openai_compatible": {
      "llama.cpp": {
        "api_url": "http://localhost:8080/v1",
        "available_models": [
          {
            "name": "gemma-4-31B-it-bf16",
            "display_name": "Gemma 4 31B",
            "max_tokens": 257536,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
            },
          },
        ],
      },
    },
  },
}
